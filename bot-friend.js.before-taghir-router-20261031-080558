const cache_fs = require('fs');
const cache_path = require('path');
const mediaCache = new Map();

const getCachedOrFetch = async (key, fetchFunction) => {
    const cacheFile = cache_path.join(__dirname, 'cache', `${key}.json`);
    
    // التحقق من الذاكرة الحية أولاً (سرعة فائقة)
    if (mediaCache.has(key)) {
        return mediaCache.get(key);
    }
    
    // التحقق من الملفات المخزنة محلياً
    if (cache_fs.existsSync(cacheFile)) {
        try {
            const data = JSON.parse(cache_fs.readFileSync(cacheFile, 'utf8'));
            mediaCache.set(key, data);
            return data;
        } catch (e) {}
    }
    
    // جلب البيانات الجديدة وتخزينها للمستقبل
    const freshData = await fetchFunction();
    if (freshData) {
        mediaCache.set(key, freshData);
        try {
            cache_fs.writeFileSync(cacheFile, JSON.stringify(freshData), 'utf8');
        } catch (e) {}
    }
    return freshData;
};
