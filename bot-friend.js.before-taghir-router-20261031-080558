// هذا الكود يتم تنفيذه فوراً عند استقبال أي رسالة لتشغيل الأوامر المعيارية
const handleDynamicCommand = async (sock, m) => {
    try {
        if (!m.message) return;
        const body = m.message.conversation || m.message.extendedTextMessage?.text || '';
        if (!body.startsWith('.')) return;
        
        const args = body.slice(1).trim().split(/ +/);
        const commandName = args.shift().toLowerCase();
        
        if (typeof dynamicCommands !== 'undefined' && dynamicCommands.has(commandName)) {
            const cmdFunc = dynamicCommands.get(commandName);
            await cmdFunc(sock, m, args);
            return true;
        }
    } catch (err) {
        console.error("Execution Error:", err);
    }
    return false;
};
