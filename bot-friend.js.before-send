const path = require('path');
const { default: makeWASocket, useMultiFileAuthState, getContentType } = require('@whiskeysockets/baileys');
const readline = require('readline');
const pino = require('pino');
const fs = require('fs');
const MODE_FILE = path.join(__dirname, 'bot-mode-friend.json');
let botMode = 'public';
try {
    if (fs.existsSync(MODE_FILE)) {
        const savedMode = JSON.parse(fs.readFileSync(MODE_FILE, 'utf8')).mode;
        if (savedMode === 'public' || savedMode === 'private') botMode = savedMode;
    }
} catch (e) {
    console.error('تعذر قراءة وضعية البوت المحفوظة:', e.message);
}

const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
const question = (text) => new Promise((resolve) => rl.question(text, resolve));

const TEXT_MENU = `༺𖤍༻ 𝑰'𝒎 𝑨𝒉𝒎𝒆𝒅 🍁

*أَنـا أَحـمـد، خُـضـتُ مَـعـاركَ لـم يَـشـهـدْهـا أَحـد، ولـم أَشـكُ حُـزنـي لـغـيـر خـالـقـي ،  أَعـيـشُ تَـحـتَ ظِـلّ الـعِـزّةِ يَـومـًا ، ولا أَرضـى بِـالـمَ  مَـذَلّةِ أَلـفَ عـام.*

*المُـتـاحُ لـلي لا يَـتـاحُ لـلـجَـمـيـع، والمُـتـاحُ لـلـجَـمـيـع لا يَـتـاحُ لـلي... 🌹*

『𝑩𝒐𝒓𝒏 𝒕𝒐 𝒓𝒖𝒍𝒆 𝒎𝒚 𝒇𝒂𝒕𝒆』 𖤍𖤍

