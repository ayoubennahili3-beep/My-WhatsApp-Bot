import sys, os
from PIL import Image, ImageDraw, ImageFont

bg, title, channel, duration, output = sys.argv[1:6]

font_dir = os.path.join(
    os.environ.get("PREFIX", "/data/data/com.termux/files/usr"),
    "share/fonts/TTF"
)
BOLD = os.path.join(font_dir, "DejaVuSansCondensed-Bold.ttf")
REG = os.path.join(font_dir, "DejaVuSans.ttf")

im = Image.open(bg).convert("RGBA")
draw = ImageDraw.Draw(im)

def wrap_text(text, font, max_width):
    words = str(text or "غير معروف").split()
    lines, line = [], ""

    for word in words:
        test = (line + " " + word).strip()
        if draw.textbbox((0, 0), test, font=font)[2] <= max_width:
            line = test
        else:
            if line:
                lines.append(line)
            line = word

    if line:
        lines.append(line)
    return lines or ["غير معروف"]

def smart_text(text, box, font_path, max_size, min_size,
               max_lines=1, align="left"):
    x, y, w, h = box
    chosen = None

    for size in range(max_size, min_size - 1, -1):
        font = ImageFont.truetype(font_path, size)
        lines = wrap_text(text, font, w - 32)

        if len(lines) <= max_lines:
            heights = [
                draw.textbbox((0, 0), line, font=font, stroke_width=1)[3]
                - draw.textbbox((0, 0), line, font=font, stroke_width=1)[1]
                for line in lines
            ]
            spacing = max(3, size // 5)
            total = sum(heights) + spacing * (len(lines) - 1)

            if total <= h - 12:
                chosen = (font, lines, heights, spacing, total)
                break

    if chosen is None:
        font = ImageFont.truetype(font_path, min_size)
        lines = wrap_text(text, font, w - 32)[:max_lines]
        heights = [draw.textbbox((0, 0), line, font=font)[3]
                   - draw.textbbox((0, 0), line, font=font)[1]
                   for line in lines]
        spacing = 3
        total = sum(heights) + spacing * (len(lines) - 1)
    else:
        font, lines, heights, spacing, total = chosen

    cy = y + (h - total) // 2

    for line, height in zip(lines, heights):
        bbox = draw.textbbox((0, 0), line, font=font, stroke_width=1)
        tw = bbox[2] - bbox[0]

        if align == "center":
            tx = x + (w - tw) // 2
        else:
            tx = x + 16

        ty = cy - bbox[1]

        draw.text((tx+2, ty+3), line, font=font,
                  fill=(65, 0, 120, 255),
                  stroke_width=3, stroke_fill=(100, 20, 180, 255))
        draw.text((tx, ty), line, font=font,
                  fill=(255, 255, 255, 255),
                  stroke_width=1, stroke_fill=(190, 140, 255, 255))

        cy += height + spacing

# تغطية النص القديم بالكامل داخل الخانات
panels = [
    (490, 680, 1060, 792),
    (490, 830, 1010, 910),
    (490, 950, 780, 1025)
]
for x1, y1, x2, y2 in panels:
    draw.rounded_rectangle(
        (x1, y1, x2, y2),
        radius=12,
        fill=(12, 3, 22, 255)
    )

# عنوان الأغنية: سطر أو سطران أو ثلاثة حسب الطول
smart_text(title, (490, 680, 1060, 792),
           BOLD, 38, 22, max_lines=3)

# القناة والمدة: حجم متكيف مع المساحة
smart_text(channel, (490, 830, 1010, 910),
           REG, 30, 19, max_lines=2)

smart_text(duration, (490, 950, 780, 1025),
           BOLD, 34, 22, max_lines=1)

im.save(output, "PNG")
print("SMART CARD OK")
