function transliterateArabicName(name) {
  const letters = {
    'ا':'a','أ':'a','إ':'i','آ':'aa','ب':'b','ت':'t','ث':'th','ج':'j',
    'ح':'h','خ':'kh','د':'d','ذ':'dh','ر':'r','ز':'z','س':'s','ش':'sh',
    'ص':'s','ض':'d','ط':'t','ظ':'z','ع':'a','غ':'gh','ف':'f','ق':'q',
    'ك':'k','ل':'l','م':'m','ن':'n','ه':'h','ة':'a','و':'ou','ي':'y',
    'ى':'a','ء':'','ئ':'y','ؤ':'w','پ':'p','ڤ':'v','گ':'g'
  };
  return [...name].map(ch => letters[ch] || (/[\u064B-\u065F\u0670ـ]/u.test(ch) ? '' : ch))
    .join('').replace(/\s+/g, ' ').trim().toUpperCase();
}

function setOwnerName(input) {
  const name = input.trim().replace(/\s+/g, ' ');
  const key = name.toLocaleLowerCase();
  const isArabic = /[\u0600-\u06FF]/u.test(name);
  let arabic, latin;

  if (isArabic) {
    arabic = name;
    latin = OWNER_NAME_MAP[name] || transliterateArabicName(name);
  } else {
    latin = name.toUpperCase();
    arabic = OWNER_NAME_MAP[key] || name;
  }

  const aliases = [...new Set([
    ...(Array.isArray(ownerNameConfig.aliases) ? ownerNameConfig.aliases : []),
    ownerNameConfig.arabic,
    ownerNameConfig.latin
  ].filter(Boolean))];

  ownerNameConfig = { arabic, latin, aliases };
  fs.writeFileSync(OWNER_NAME_FILE, JSON.stringify(ownerNameConfig, null, 2), 'utf8');
  return ownerNameConfig;
}

function replaceOwnerText(value) {
  if (typeof value !== 'string') return value;

  const arabic = ownerNameConfig.arabic;
  const latin = ownerNameConfig.latin;
  const latinTitle = latin.charAt(0).toUpperCase() + latin.slice(1).toLowerCase();

  function normalizeName(str) {
    return String(str).normalize('NFKD')
      .replace(/[\u0640\u064B-\u065F\u0670]/gu, '')
      .replace(/\p{M}/gu, '')
      .replace(/[أإآٱ]/gu, 'ا')
      .replace(/ى/gu, 'ي')
      .toLowerCase();
  }

  const knownNames = new Set([
    '𝑻𝒐𝒋𝒊 𝑭𝒖𝒔𝒉𝒊𝒈𝒖𝒓𝒐', 'ayoub',
    ...(Array.isArray(ownerNameConfig.aliases) ? ownerNameConfig.aliases : []),
    arabic,
    latin
  ].map(normalizeName));

  // حماية أسماء الأوامر الثابتة من تغيير اسم المالك
  const protectedParts = [];
  let safeValue = value.replace(/\bthe prince ayoub\b/giu, match => {
    protectedParts.push(match);
    return '\uE000' + (protectedParts.length - 1) + '\uE001';
  });

  safeValue = safeValue.replace(/[\p{L}\p{M}\u0640]+/gu, token => {
    if (!knownNames.has(normalizeName(token))) return token;
    return /[\u0600-\u06FF]/u.test(token) ? arabic : latinTitle;
  });

  return safeValue.replace(/\uE000(\d+)\uE001/gu, (_, index) => protectedParts[Number(index)]);
}
