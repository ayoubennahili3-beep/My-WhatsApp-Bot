const __memoryCache = new Map();
function getCachedJson(filePath) {
    if (!__memoryCache.has(filePath)) {
        try {
            if (fs.existsSync(filePath)) {
                __memoryCache.set(filePath, JSON.parse(fs.readFileSync(filePath, 'utf8')));
            } else {
                return null;
            }
        } catch (e) {
            console.error('Cache read error:', e);
            return null;
        }
    }
    return __memoryCache.get(filePath);
}
function setCachedJson(filePath, data) {
    __memoryCache.set(filePath, data);
    try {
        fs.writeFileSync(filePath, JSON.stringify(data, null, 2) + '\n');
    } catch (e) {
        console.error('Cache write error:', e);
    }
}

function getCachedFile(filePath) {
    const started = process.hrtime.bigint();
    const key = 'file:' + filePath;
    const cached = __memoryCache.has(key);
    if (!cached) {
        try {
            if (!fs.existsSync(filePath)) return null;
            __memoryCache.set(key, fs.readFileSync(filePath));
        } catch (e) {
            console.error('Cache file read error:', e.message);
            return null;
        }
    }
    const elapsed = Number(process.hrtime.bigint() - started) / 1e6;
    console.log('[IMAGE_PREP_TIME]', filePath, elapsed.toFixed(2) + 'ms', cached ? 'CACHE' : 'FILE_READ');
    return __memoryCache.get(key);
}

