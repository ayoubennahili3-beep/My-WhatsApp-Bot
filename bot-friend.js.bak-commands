    await sock.sendMessage(from, {
        video: fs.readFileSync(videoPath),
        mimetype: 'video/mp4',
        ptv: true
    }, { quoted: mek });

    const nextIndex = (quoteIndex + 1) % quotes.length;
    fs.writeFileSync(indexFile, JSON.stringify({ index: nextIndex }));

