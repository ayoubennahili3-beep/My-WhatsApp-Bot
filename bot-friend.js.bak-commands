const path = require('path');
const { default: makeWASocket, useMultiFileAuthState, getContentType } = require('@whiskeysockets/baileys');
const readline = require('readline');
const pino = require('pino');
const fs = require('fs');
const yts = require('yt-search');
const MODE_FILE = path.join(__dirname, 'bot-mode-friend.json');
let botMode = 'public';
try {
    if (fs.existsSync(MODE_FILE)) {
        const savedMode = JSON.parse(fs.readFileSync(MODE_FILE, 'utf8')).mode;
        if (savedMode === 'public' || savedMode === 'private') botMode = savedMode;
    }
} catch (e) {
    console.error('تعذر قراءة وضعية البوت المحفوظة:', e.message);
}

const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
const question = (text) => new Promise((resolve) => rl.question(text, resolve));

const TEXT_MENU = `༺𖤍༻ 𝑰'𝒎 𝑨𝒉𝒎𝒆𝒅 🍁

*أَنـا أَحـمـد، خُـضـتُ مَـعـاركَ لـم يَـشـهـدْهـا أَحـد، ولـم أَشـكُ حُـزنـي لـغـيـر خـالـقـي ،  أَعـيـشُ تَـحـتَ ظِـلّ الـعِـزّةِ يَـومـًا ، ولا أَرضـى بِـالـمَ  مَـذَلّةِ أَلـفَ عـام.*

*المُـتـاحُ لـلي لا يَـتـاحُ لـلـجَـمـيـع، والمُـتـاحُ لـلـجَـمـيـع لا يَـتـاحُ لـلي... 🌹*

『𝑩𝒐𝒓𝒏 𝒕𝒐 𝒓𝒖𝒍𝒆 𝒎𝒚 𝒇𝒂𝒕𝒆』 𖤍𖤍

🍁 𝒀𝒐𝒉𝒂𝒏 𝑳𝒊𝒆𝒃𝒆𝒓𝒕 ツ 🤍 : 𓆩 🌹 𝐓𝐡𝐞 𝑷𝒓𝒊𝒏𝒄𝒆 🌹 𓆪`;

const TEXT_TEST1 = `𓆩 𝑰 𝒂𝒎 𝑨𝒉𝒎𝒆𝒅 , 𝒘𝒉𝒂𝒕 𝒊𝒔 𝒂𝒗𝒂𝒊𝒍𝒂𝒃𝒍𝒆 𝒕𝒐 𝒎𝒆 𝒊𝒔 𝒏𝒐𝒕 𝒂𝒗𝒂𝒊𝒍𝒂𝒃𝒍𝒆 𝒕𝒐 𝒆𝒗𝒆𝒓𝒚𝒐𝒏𝒆, 𝒂𝒏𝒅 𝒘𝒉𝒂𝒕 𝒊𝒔 𝒂𝒗𝒂𝒊𝒍𝒂𝒃𝒍𝒆 𝒕𝒐 𝒆𝒗𝒆𝒓𝒚𝒐𝒏𝒆 𝒊𝒔 𝒏𝒐𝒕 𝒂𝒗𝒂𝒊𝒍𝒂𝒃𝒍𝒆 𝒕𝒐 𝒎𝒆, 𝒂𝒏𝒅 𝒂 𝒎𝒂𝒏 𝒏𝒆𝒗𝒆𝒓 𝒓𝒆𝒗𝒆𝒂𝒍𝒔 𝒉𝒊𝒔 𝒘𝒆𝒂𝒌𝒏𝒆𝒔𝒔 𝒃𝒆𝒇𝒐𝒓𝒆 𝒐𝒕𝒉𝒆𝒓𝒔. 𓆩🌹𓆪`;

const TEXT_TEST2 = `*༺ أَلَـا مَـوْتٌ يُـبَـاعُ فَـأَشْـتَـرِيـهِ ، فَـهَـذَا الـعَـيْـشُ لَا خَـيْـرَ فِـيـهِ ، أَلَـا مَـوْتٌ ذُو طَـعْـمٍ يَـأْتِـي ، يُـخَـلِّـصُـنِـي مِـنَ الـعَـيْـشِ الـكَـرِيـهِ… ༻ 🌹*`;

const TEXT_TEST3 = `𓆩 𝑾𝒆 𝒂𝒓𝒆 𝒂𝒏 𝒊𝒅𝒆𝒂, 𝒂𝒏𝒅 𝒊𝒅𝒆𝒂𝒔 𝒏𝒆𝒗𝒆𝒓 𝒅𝒊𝒆 , 𝒆𝒗𝒆𝒏 𝒊𝒇 𝒕𝒉𝒆𝒊𝒓 𝒄𝒓𝒆𝒂𝒕𝒐𝒓 𝒅𝒊𝒆𝒔. ༺ 𝒀𝒐𝒉𝒂𝒏 𝑳𝒊𝒆𝒃𝒆𝒓𝒕 ༻ 𓆩🌹𓆪`;

const TEXT_TEST4 = `*༺ وَبَـقِـيَ أَحْـمَـدُ وَحْـدَهُ ، سَـقَـطَ يَـوْمًـا فَـنَـهَـضَ بِـعَـزِيـمَـةٍ لَا تَـلِـيـنُ ، وَحَـارَبَ الـدَّهْـرَ مُـنْـفَـرِدًا ، يُـخْـفِـي هُـمُـومَـهُ خَـلْـفَ صَـمْـتِـهِ وَلَا يَـشْـكُـو لِـأَحَـدٍ وَجَـعَـهُ ، فَـصَـنَـعَ مِـنْ انْـكِـسَـارِهِ قُـوَّةً وَمِـنْ وَحْـدَتِـهِ مَـجْـدًا لَا يَـقْـهَـرُهُ الـزَّمَـنُ… ༻ 🌹*`;

async function start() {
    const { state, saveCreds } = await useMultiFileAuthState(require('path').join(__dirname, 'session-ayoub-friend'));
    
    const sock = makeWASocket({
        auth: state,
        logger: pino({ level: 'silent' }),
        browser: ["Ubuntu", "Chrome", "20.0.04"],
        syncFullHistory: false
    });

    sock.ev.on('creds.update', saveCreds);

    sock.ev.on('connection.update', (update) => {
        const { connection, lastDisconnect } = update;
        const statusCode = lastDisconnect?.error?.output?.statusCode;

        if (connection === 'close') {
            console.log('🔄 انقطع الاتصال.');
            console.log('سبب الانقطاع:', lastDisconnect?.error?.message || 'غير معروف');
            console.log('رمز الانقطاع:', statusCode || 'غير متوفر');

            if (statusCode === 401) {
                console.log('⛔ انتهت صلاحية الجلسة أو تم تسجيل الخروج. إيقاف إعادة الاتصال وطلب ربط جديد.');
                (async () => {
                    const fs = require('fs');
                    const path = require('path');
                    const sessionDir = path.join(__dirname, 'session-ayoub-friend');
                    const backupDir = sessionDir + '-rejected-' + Date.now();

                    try {
                        if (fs.existsSync(sessionDir)) {
                            fs.renameSync(sessionDir, backupDir);
                            console.log('📦 حفظنا الجلسة القديمة في:', backupDir);
                        }
                        fs.mkdirSync(sessionDir, { recursive: true });
                        console.log('📲 ستحتاج إلى إدخال رقم الهاتف مع رمز الدولة للحصول على رمز اقتران جديد.');
                        await start();
                    } catch (err) {
                        console.log('❌ تعذر بدء جلسة جديدة:', err.message);
                        console.log('الجلسة القديمة محفوظة إن كان نقلها قد نجح.');
                    }
                })();
                return;
            }

            setTimeout(() => {
                start().catch(err => console.log('❌ خطأ في إعادة التشغيل:', err.message));
            }, 5000);
        } else if (connection === 'open') {
            console.log('✅ تم اتصال البوت بنجاح وهو جاهز الآن لاستقبال الأوامر!');
        }
    });

    if (!sock.authState.creds.registered) {
        const phoneNumber = await question('📲 ادخل رقم البوت مع رمز الدولة (مثال: 212xxxxxxxxx): ');
        const cleanNumber = phoneNumber.replace(/\D/g, '');
        setTimeout(async () => {
            try {
                const code = await sock.requestPairingCode(cleanNumber);
                console.log('\n🔑 كود الربط الخاص بك هو: ' + code + '\n');
            } catch (err) {
                console.log('❌ خطأ أثناء طلب الكود: ', err.message);
            }
        }, 3000);
    }

    sock.ev.on('messages.upsert', async ({ messages, type }) => {
        try {
            if (type !== 'notify' && type !== 'append') return;

            for (const mek of messages || []) {
                if (!mek.message) continue;

                const from = mek.key.remoteJid;
                if (!from) continue;

                const msg = mek.message;
                const body = (
                    msg.conversation ||
                    msg.extendedTextMessage?.text ||
                    msg.imageMessage?.caption ||
                    msg.videoMessage?.caption ||
                    msg.documentMessage?.caption ||
                    ''
                ).trim();

                const match = body.match(/^[.!]?\s*(?:تست|test)\s*([1-5١-٥])\s*$/i);
                const command = body.replace(/^[.!]/, '').trim().toLowerCase();

                if (command === 'تست برو') {
                    const videoPath = '/storage/emulated/0/New time 2222/tem20.mp4';
                    const audioPath = '/storage/emulated/0/sawt 333333/sawt555555.mp3';

                    if (!fs.existsSync(videoPath) || !fs.existsSync(audioPath)) {
                        await sock.sendMessage(from, {
                            text: '❌ ملف الفيديو أو الصوت غير موجود.'
                        }, { quoted: mek });
                        continue;
                    }

                    try {
                        await sock.sendMessage(from, {
                            text: '*༺ أَنَـا أَحْـمَـدُ ، أُحِـبّ الـصَّـالِـحِـيـنَ وَلَـسْـتُ مِـنْـهُـمْ لَـعَـلِّـي أَنْ أَنَـالَ بِـهِـمْ شَـفَـاعَـةً وَأَكْـرَهُ مَـنْ تِـجَـارَتُـهُ الْـمَـعَـاصِـي وَإِنْ كُـنَّـا سَـوَاءً فِـي الْـبِـضَـاعَـةِ فَـلَا يَـتَـأَلَّـمُ إِلَّا مَـنْ كَـانَ وَفِـيًّـا صَـادِقًـا  فَٱلحـمـد للـه نـشـڪوا ڪثـيـࢪا ونـنـسـى نِـ؏ـمـه...🌹༻*'
                        }, { quoted: mek });

                        await sock.sendMessage(from, {
                            video: fs.readFileSync(videoPath),
                            mimetype: 'video/mp4',
                            ptv: true
                        }, { quoted: mek });

                        await sock.sendMessage(from, {
                            audio: fs.readFileSync(audioPath),
                            mimetype: 'audio/mpeg',
                            ptt: false
                        }, { quoted: mek });
                    } catch (err) {
                        console.error('خطأ في أمر تست برو:', err);
                        await sock.sendMessage(from, {
                            text: '❌ وقع خطأ أثناء إرسال المحتوى.'
                        }, { quoted: mek });
                    }
                    continue;
                }



                const senderJid = mek.key.fromMe
                    ? sock.user?.id
                    : (mek.key.participant || mek.key.remoteJid);
                const senderNumber = (senderJid || '').split('@')[0].split(':')[0];
                const developerNumbers = [
    '212613436438',
    '212697304172',
    '212704777168',
    '212726204806'
];
const isDeveloper = developerNumbers.includes(senderNumber);


                const sendMatch = body.match(/^[.!]\s*ارسل\s+(\d{10,15})\s+([\s\S]+)$/);

                if (sendMatch) {
                    if (!isDeveloper && !mek.key.fromMe) {
                        await sock.sendMessage(from, {
                            text: '⛔ أمر الإرسال مخصص للمطوّر فقط.'
                        }, { quoted: mek });
                        continue;
                    }

                    const targetNumber = sendMatch[1];
                    const outgoingText = sendMatch[2].trim();

                    if (!outgoingText) {
                        await sock.sendMessage(from, {
                            text: '⚠️ اكتب نص الرسالة بعد الرقم.'
                        }, { quoted: mek });
                        continue;
                    }

                    try {
                        await sock.sendMessage(
                            targetNumber + '@s.whatsapp.net',
                            { text: outgoingText }
                        );
                        await sock.sendMessage(from, {
                            text: '✅ تم إرسال الرسالة إلى ' + targetNumber
                        }, { quoted: mek });
                    } catch (err) {
                        await sock.sendMessage(from, {
                            text: '❌ تعذر الإرسال: ' + err.message
                        }, { quoted: mek });
                    }
                    continue;
                }


                const songMatch = body.match(/^[.!]\s*اغنية\s+([\s\S]+)$/i);
                if (songMatch) {
                    const query = songMatch[1].trim();
                    if (!query) {
                        await sock.sendMessage(from, { text: '🎵 اكتب اسم الأغنية بعد الأمر .اغنية' }, { quoted: mek });
                        continue;
                    }

                    let audioPath;
                    try {
                        await sock.sendMessage(from, { text: '🔎 كنقلب على: ' + query }, { quoted: mek });

                        const search = await yts(query);
                        const result = search.videos && search.videos[0];
                        if (!result || !result.url) {
                            await sock.sendMessage(from, { text: '❌ ما لقيتش نتيجة مناسبة. جرّب اسم الأغنية مع اسم الفنان.' }, { quoted: mek });
                            continue;
                        }

                        const { execFileSync } = require('child_process');
                        audioPath = path.join(require('os').tmpdir(), 'ahmed-song-' + Date.now() + '.mp3');

                        const caption = [
                            '🎧 *AUDIO SEARCH*',
                            '╭━━❐━⪼',
                            '┇ 🎵 *العنوان:* ' + result.title,
                            '┇ 👤 *القناة:* ' + (result.author?.name || 'غير معروف'),
                            '┇ ⏱️ *المدة:* ' + (result.timestamp || 'غير معروفة'),
                            '╰━━❑━⪼',
                            '> AHMED BOT'
                        ].join('\n');

                        if (result.thumbnail) {
                            try {
                                await sock.sendMessage(from, {
                                    image: { url: result.thumbnail },
                                    caption
                                }, { quoted: mek });
                            } catch (_) {
                                await sock.sendMessage(from, { text: caption }, { quoted: mek });
                            }
                        } else {
                            await sock.sendMessage(from, { text: caption }, { quoted: mek });
                        }

                        execFileSync('yt-dlp', [
                            '--no-playlist',
                            '-f', 'bestaudio/best',
                            '-x',
                            '--audio-format', 'mp3',
                            '--max-filesize', '25M',
                            '-o', audioPath,
                            result.url
                        ], { timeout: 180000, stdio: 'pipe' });

                        if (!fs.existsSync(audioPath)) {
                            throw new Error('ما تخلقش ملف الصوت');
                        }

                        await sock.sendMessage(from, {
                            audio: fs.readFileSync(audioPath),
                            mimetype: 'audio/mpeg',
                            fileName: 'song.mp3'
                        }, { quoted: mek });

                    } catch (err) {
                        console.error('Song command error:', err.message);
                        await sock.sendMessage(from, {
                            text: '⚠️ لقيت/بحثت على الأغنية، ولكن تعذّر جلب الصوت. جرّب لاحقاً أو اختار مصدر صوت مسموح بالتنزيل.'
                        }, { quoted: mek });
                    } finally {
                        if (audioPath && fs.existsSync(audioPath)) {
                            try { fs.unlinkSync(audioPath); } catch (_) {}
                        }
                    }
                    continue;
                }


                
                // MARJANA_COMMAND
                if (command === 'marjana' || command === 'مرجانة') {
                    const marjanaVideo = '/storage/emulated/0/mom new/mom3.mp4';
                    const marjanaText = '*_༻شَـرِبـتُ كُـؤوسَ الـخَـمـرِ لِـكَـي أنـسـاكِ ، وَ إذْ بِـكُـلِّ كَـأسٍ أشـرَبُـهُ أراكِ... مـا سـالَ الـدَّمـعُ إلّا لِـذِكـراكِ... قَـسَـمـاً بِـرَبِّ الـعِـبـادِ لَـنْ أنـسـاكِ... أمَـرتُ الـنِّـسـيـانَ أنْ يُـنـسـيـكِ ، فَـنَـسـيـتُ الـنِّـسـيـانَ وَ لَـمْ أنـسـاكِ... ༺ 🌹_*';
                    try {
                        if (!fs.existsSync(marjanaVideo)) {
                            await sock.sendMessage(from, {
                                text: '❌ لم أجد الفيديو mom3.mp4 في مجلد mom new.'
                            }, { quoted: mek });
                        } else {
                            await sock.sendMessage(from, {
                                text: marjanaText
                            }, { quoted: mek });

                            await sock.sendMessage(from, {
                                video: fs.readFileSync(marjanaVideo),
                                mimetype: 'video/mp4',
                                ptv: true
                            }, { quoted: mek });
                        }
                    } catch (err) {
                        console.error('خطأ في أمر marjana:', err);
                        await sock.sendMessage(from, {
                            text: '❌ وقع خطأ أثناء إرسال النص أو الفيديو.'
                        }, { quoted: mek });
                    }
                    continue;
                }


                // AOA_COMMAND
                if (command.toLowerCase() === 'aoa') {
                    const aoaVideo = '/storage/emulated/0/new aoa/aoa20.mp4';
                    const aoaAudio = '/storage/emulated/0/new aoa/aud1110.mp3';
                    const aoaText = '*༺  _إذا ذُكِـرَ الـذَّكـاءُ ذُكِـرَ أيّـوبُ ، وَ إذا ذُكِـرَ الـتَّـخـطـيـطُ ذُكِـرَ أحـمَـدُ ، وَ إذا ذُكِـرَتِ الـحِـكـمَـةُ ذُكِـرَ أسـامَـةُ ، وَ إذا ذُكِـرَ الـصَّـمـتُ ذُكِـرَ أشـرَفُ ، وَ إذا ذُكِـرَتِ الاسـتِـراتـيـجِـيَّـةُ ذُكِـرَ سَـعـيـدٌ ، وَ إذا ذُكِـرَ الـوَفـاءُ ذُكِـرَ عـادِلٌ ، وَ إذا ذُكِـرَتِ الاسـتِـمـرارِيَّـةُ ذُكِـرَ حَـسَـنٌ ، وَ إذا ذُكِـرَ الـتَّـحـلـيـلُ ذُكِـرَ يُـونُـسُ ، وَ إذا ذُكِـرَتِ الـشِّـيـمَـةُ ذُكِـرَ بــلالٌ... نَـكـتَـمِـلُ وَ يَـكـتَـمِـلُ الـمَـجـدُ... A.O.A_ 🌹༺*';

                    try {
                        if (!fs.existsSync(aoaVideo) || !fs.existsSync(aoaAudio)) {
                            await sock.sendMessage(from, {
                                text: '❌ تأكد من وجود aoa20.mp4 و aud1110.mp3 داخل مجلد new aoa.'
                            }, { quoted: mek });
                        } else {
                            await sock.sendMessage(from, {
                                text: aoaText
                            }, { quoted: mek });

                            await sock.sendMessage(from, {
                                video: fs.readFileSync(aoaVideo),
                                mimetype: 'video/mp4',
                                ptv: true
                            }, { quoted: mek });

                            await sock.sendMessage(from, {
                                audio: fs.readFileSync(aoaAudio),
                                mimetype: 'audio/mpeg',
                                fileName: 'aud1110.mp3'
                            }, { quoted: mek });
                        }
                    } catch (err) {
                        console.error('خطأ في أمر AOA:', err);
                        await sock.sendMessage(from, {
                            text: '❌ وقع خطأ أثناء إرسال محتوى AOA.'
                        }, { quoted: mek });
                    }
                    continue;
                }

// PRINCE_AHMED_COMMAND
                if (command === 'الامير' || command === 'الأمير') {
                    const princeVideo = '/storage/emulated/0/Download/naro2.mp4';
