        '*⚔️ لا يطارد أحمد الأضواء؛ يمضي في طريقه، ويترك للمجد مهمة اللحاق به ⚔️*',
        '*𓆩 ليس العلوّ أن تكون فوق الجميع، بل أن تبقى ثابتاً حين تتغير الوجوه؛ تلك شيمة أحمد 𓆪*',
        '*༺═── أحمد اسمٌ لا يحتاج إلى ضجيج كي يُذكر، ولا إلى تاج كي يُعرف مقامه ──═༻*',
        '*𖤍 في زمنٍ يكثر فيه الادعاء، يترك أحمد أفعاله تتحدث، ويترك للهيبة بقية الحكاية 𖤍*',
        '*🌹 بعض الحضور عابر، وبعضهم يصبح ذكرى؛ أما أحمد فيجعل للحضور معنى وللذكرى مقاماً 🌹*',
        '*༒ لا تصنعه الألقاب، ولا ترفعه المظاهر؛ أحمد يرفع مقامه بثباته حين تهتز الخطوات ༒*',
        '*⚜️ للمجد أبواب، وللهيبة أسرار، ولأحمد طريقٌ يشقه بعزيمة لا تستعير قوتها من أحد ⚜️*',
        '*𓆩 يمرّ البعض في المكان، ويترك أحمد أثراً في الذاكرة؛ فليست كل الخطوات سواء 𓆪*',
        '*🖤 هدوء أحمد ليس غياباً، وصمته ليس ضعفاً؛ ففي بعض السكون تختبئ أعظم العواصف 🖤*',
        '*༺ لا يحتاج صاحب المقام إلى إعلان عظمته كل يوم؛ يكفي أن تشهد له مواقفه، وهذا أحمد ༻*',
        '*⚔️ إذا كان للمجد عنوان، فللثبات حكاية، وللهيبة حضور؛ وفي هذه الحكاية يكتب أحمد اسمه ⚔️*'
    ];

    try {
        const images = fs.readdirSync(imageDir)
            .filter(name => /\.(jpe?g|png|webp)$/i.test(name));

        if (images.length === 0) {
            await sock.sendMessage(from, {
                text: '⚠️ لم أجد صوراً داخل مجلد AHMED-BOT/images.'
            }, { quoted: mek });
            continue;
        }

        const stateFile = path.join(imageDir, '.heiba-state.json');
        let previous = {};
        try {
            previous = JSON.parse(fs.readFileSync(stateFile, 'utf8'));
        } catch (_) {}

        let imageIndex = Math.floor(Math.random() * images.length);
        if (images.length > 1 && imageIndex === previous.imageIndex) {
            imageIndex = (imageIndex + 1) % images.length;
        }

        let quoteIndex = Math.floor(Math.random() * quotes.length);
        if (quotes.length > 1 && quoteIndex === previous.quoteIndex) {
            quoteIndex = (quoteIndex + 1) % quotes.length;
        }

        fs.writeFileSync(stateFile, JSON.stringify({
            imageIndex,
            quoteIndex
        }));

        const imagePath = path.join(imageDir, images[imageIndex]);

        await sock.sendMessage(from, {
            image: fs.readFileSync(imagePath),
            caption: quotes[quoteIndex]
        }, { quoted: mek });

    } catch (err) {
        console.error('HEIBA ERROR:', err);
        await sock.sendMessage(from, {
            text: '⚠️ وقع خطأ أثناء تشغيل الأمر .هيبة.'
        }, { quoted: mek });
    }

    continue;
}

if (['menu', 'المنيو', 'الاوامر'].includes(command)) {
                    const imagePath = '/storage/emulated/0/imenu.jpg/image 1.jpg';
                    const audioPath = '/storage/emulated/0/Download/Telegram/Aud 100.mp3';

                    if (fs.existsSync(imagePath)) {
                        await sock.sendMessage(from, {
                            image: fs.readFileSync(imagePath),
                            caption: TEXT_MENU
                        }, { quoted: mek });
                    } else {
                        await sock.sendMessage(from, { text: TEXT_MENU }, { quoted: mek });
                    }

                    if (fs.existsSync(audioPath)) {
                        await sock.sendMessage(from, {
                            audio: fs.readFileSync(audioPath),
                            mimetype: 'audio/mpeg',
                            ptt: false
                        }, { quoted: mek });
                    }
                    continue;
                }


                if (command === 'oussama') {
                    const caption = '*༺ كُـنَّـا إِخْـوَةً لَا تُـفَـرِّقُـنَـا الـلَّـيَـالِـي  فَـمَـا لِـي أَرَى الـدَّرْبَ قَـدْ قُـسِّـمَ ، وَصَـارَ الَّـذِي كَـانَ قَـرِيـبًـا يُـفَـارِقُ ، أَيْـنَ عَـهْـدُ الـرِّجَـالِ ؟ أَيْـنَ يَـمِـيـنُـنَـا؟ أَنَـمْـضِـي وَنَـنْـسَـى أَنَّـنَـا قَـدْ تَـعَـاهَـدْنَـا ؟ مَـا خَـانَ أَحْـمَـدُ ، وَلَا خَـانَ الْـفُـؤَادُ ، لَـكِـنَّـهَـا الْأَقدار شَـاءَتْ أَنْ نَـتَـمَـزَّقَ ، سَـنَـبْـقَـى وَإِنْ فَـرَّقَـتْـنَـا الْـمَـسَـافَـاتُ إخْـوَةَ دَمٍ ، لَا يَـذِلُّ وَلَا يُـسَـاوَمُ...🌹༻*';
                    await sock.sendMessage(from, { text: caption }, { quoted: mek });

                    const videoPath = '/storage/emulated/0/New 0000000/ousama3.mp4';
                    const audioPath = '/storage/emulated/0/New kkkkkk/sawt230.mp3';

                    const fs = require('fs');
                    if (fs.existsSync(videoPath)) {
                        await sock.sendMessage(from, {
                            video: fs.readFileSync(videoPath),
                            ptv: true
                        }, { quoted: mek });
                    } else {
                        await sock.sendMessage(from, { text: '❌ لم أجد ملف الفيديو.' }, { quoted: mek });
                    }

                    if (fs.existsSync(audioPath)) {
                        await sock.sendMessage(from, {
                            audio: fs.readFileSync(audioPath),
                            mimetype: 'audio/mpeg',
                            ptt: false
                        }, { quoted: mek });
                    } else {
                        await sock.sendMessage(from, { text: '❌ لم أجد ملف الصوت.' }, { quoted: mek });
                    }
                    continue;
                }

                if (!match) continue;

                const digit = match[1].replace(/[١٢٣٤]/g, d => '١٢٣٤'.indexOf(d) + 1);
                const n = Number(digit);
                const texts = { 1: TEXT_TEST1, 2: TEXT_TEST2, 3: TEXT_TEST3, 4: TEXT_TEST4 };

                await sock.sendMessage(from, { text: texts[n] }, { quoted: mek });

                if (n <= 3) {
                    const dir = '/storage/emulated/0/EDIT NEW';
                    if (fs.existsSync(dir)) {
                        const files = fs.readdirSync(dir)
                            .filter(f => f.toLowerCase().endsWith('.mp4'))
                            .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));

                        if (files[n - 1]) {
                            await sock.sendMessage(from, {
                                video: fs.readFileSync(path.join(dir, files[n - 1])),
                                mimetype: 'video/mp4',
                                ptv: true
                            }, { quoted: mek });
                        }
                    }
                } else {
                    const dir = '/storage/emulated/0/NEW BOT EDIT';
                    if (fs.existsSync(dir)) {
                        const files = fs.readdirSync(dir)
                            .filter(f => f.toLowerCase().endsWith('.mp4'))
                            .sort();
                        if (files[0]) {
                            await sock.sendMessage(from, {
                                video: fs.readFileSync(path.join(dir, files[0])),
                                mimetype: 'video/mp4',
                                ptv: true
                            }, { quoted: mek });
                        }
                    }
                }
            }
        } catch (err) {
            console.error('خطأ معالجة الرسالة:', err);
        }
    });
}

start();

